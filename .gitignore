__pycache__/
*.py[cod]
*.pyo
*.pyd

# ── Jupyter ───────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Egg / build / dist ────────────────────────────────────────────────────
*.egg-info/
*.egg
dist/
build/
.eggs/

